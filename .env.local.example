# ─────────────────────────────────────────────────────────────
# Adminbordets EGEN Supabase-database
# Dette er ikke noen av de andre systemene – adminbordet har sitt eget
# prosjekt der registeret, loggen og brukerne til adminbordet ligger.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Krypteringsnøkkel for de andre systemenes nøkler
# 32 byte, base64. Lag en med:  openssl rand -base64 32
# Byttes den, blir alle lagrede nøkler uleselige og må hentes på nytt.
# ─────────────────────────────────────────────────────────────
KRYPTONOKKEL=

# ─────────────────────────────────────────────────────────────
# Plattformtokens – valgfrie, men uten dem viser adminbordet «uvisst»
# i stedet for status.
# ─────────────────────────────────────────────────────────────

# supabase.com/dashboard/account/tokens
# Gir databasestatus, brukerlister og automatisk henting av nøkler.
SUPABASE_MANAGEMENT_TOKEN=sbp_...

# vercel.com/account/tokens
VERCEL_TOKEN=vcp_...
# Prosjektene ligger under et team. Et fullkonto-token MÅ ha denne,
# ellers svarer API-et 403 – eller, verre, gir et ufullstendig svar.
VERCEL_TEAM_ID=team_...

# Denne lager du selv – Vercel setter den IKKE automatisk. Legg den inn
# som miljøvariabel på prosjektet, og Vercel sender verdien som
# `Authorization: Bearer <verdi>` når cron-en kaller
# /api/status/oppdater. Minst 16 tilfeldige tegn.
# Lokalt: velg hva du vil, og bruk den som Bearer-token om du vil prøve
# ruten manuelt.
CRON_SECRET=
